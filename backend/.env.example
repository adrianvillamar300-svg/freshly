# Base de datos (Railway te da esta URL automáticamente al crear el Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/freshly

# JWT - genera un secreto fuerte para producción, ej: openssl rand -hex 32
JWT_SECRET=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloudinary (fotos de perfil y facturas) - cloudinary.com, plan gratis
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS Bedrock (IA para voz, facturas y recetas)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# URL del frontend desplegado (para CORS)
FRONTEND_URL=http://localhost:5173
